# Generate a strong key: openssl rand -hex 32
# WARNING: SHA-256 is used to derive the AES key, not a KDF (Argon2/PBKDF2).
# Security depends entirely on your SECRET_KEY entropy. Use a random 32+ char value.
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Optional: Slack incoming webhook or any HTTPS URL for first-view notifications
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional overrides
# MAX_SECRET_SIZE_KB=1024
# RATE_LIMIT_PER_IP=10
# PORT=8000
# BASE_URL=https://secrets.yourdomain.internal
